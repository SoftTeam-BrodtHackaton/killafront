# NASA — DEMO_KEY sirve para desarrollo (30 req/hora). https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# Backend propio de KillaLab (repo aparte). Sin esta variable la web arranca igual:
# el progreso queda en memoria y el directorio de grupos se muestra vacío, ambos
# declarados como no disponibles en pantalla.
KILLALAB_BACKEND_URL=

# IA (pipeline de contenido, no se usa en runtime del MVP)
ANTHROPIC_API_KEY=

# Fake API (apps/fake-api). Deja estas dos líneas para desarrollar sin llave ni internet;
# coméntalas para pegarle a la NASA de verdad. Todo dato que venga de aquí sale
# etiquetado en pantalla como "datos simulados".
KILLALAB_NASA_BASE=http://localhost:4000
KILLALAB_JPL_BASE=http://localhost:4000
