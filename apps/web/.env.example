# Copia este archivo a .env.local y ya está: los valores de aquí funcionan.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# La llave de la NASA es del equipo y está compartida a propósito: es un
# hackathon, es gratis y el límite de 1 000 peticiones por hora nos sobra.
# Si algún día hiciera falta una propia, se pide en https://api.nasa.gov.

NASA_API_KEY=5zUhMimN6ccQtzjd7OBkhIdCIkMxBDnCdqOAFrfK

# Backend propio de KillaLab (repo aparte). Sin esta variable la web arranca
# igual: el progreso queda en memoria y el directorio de grupos se muestra
# vacío, ambos declarados como no disponibles en pantalla.
# Ojo: solo el origen, sin prefijo de camino. Ver docs/contrato-backend.md.
KILLALAB_BACKEND_URL=

# Fake API (apps/fake-api). Con estas dos líneas se desarrolla sin internet y
# sin gastar llamadas; todo lo que venga de aquí sale etiquetado en pantalla
# como dato simulado. Coméntalas para pegarle a la NASA de verdad.
KILLALAB_NASA_BASE=http://localhost:4000
KILLALAB_JPL_BASE=http://localhost:4000

# Solo para el pipeline de contenido (docs/estudio-y-podcast.md). La web no
# llama a ningún modelo en runtime.
OLLAMA_BASE=http://localhost:11434
